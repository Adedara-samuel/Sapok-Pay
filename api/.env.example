# =====================================================================
# SAPOK Pay — Environment Configuration Example
# Copy to .env and fill in real values. Never commit the real .env file.
# =====================================================================

NODE_ENV=development
SAPOK_PAY_PORT=4100
API_GLOBAL_PREFIX=api/v1
# Public self-service platform now — the web/ dashboard calls this API
# directly from the browser. Comma-separated.
CORS_ORIGINS=http://localhost:4110

# ---------------------------------------------------------------------
# PostgreSQL — SAPOK Pay owns its own database, deliberately separate
# from NEXORA Core API's.
# ---------------------------------------------------------------------
POSTGRES_USER=sapok_pay
POSTGRES_PASSWORD=sapok_pay_dev_password
POSTGRES_DB=sapok_pay
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sapok_pay:sapok_pay_dev_password@localhost:5433/sapok_pay?schema=public

# ---------------------------------------------------------------------
# Redis — its own instance too (queues for payment/webhook processing).
# ---------------------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------
# Service-to-service authentication (Phase 3) — verifies that a request
# genuinely came from SAPOK Core API, not just anyone who can reach this
# service on the network.
# Generate a real secret with: openssl rand -base64 48
# ---------------------------------------------------------------------
SERVICE_AUTH_SECRET=replace_with_a_long_random_service_secret

# ---------------------------------------------------------------------
# Payment provider (Phase 6+) — swappable via the PaymentProvider interface.
# "mock" is the only implementation until a real bank/payment integration
# is built; business logic never branches on this value directly.
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock
MOCK_BANK_URL=http://localhost:4101

# ---------------------------------------------------------------------
# Webhook signature verification (Phase 9)
# ---------------------------------------------------------------------
WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# ---------------------------------------------------------------------
# Merchant/Admin JWT auth (dashboard sessions — API keys are separate,
# see ApiKey model). Generate a real secret with: openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------
# Seeded superadmin account (platform operator, not a merchant)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sapokpay.com
SEED_ADMIN_PASSWORD=ChangeMe123!
